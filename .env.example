# YooKassaNet integration tests.
# Copy to .env and fill in. The .env file is gitignored.
# Integration tests are skipped automatically when these are not set.

# Payments / deals / webhooks: shop credentials.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Payouts: payout gateway (agent) credentials. Usually different from the shop credentials.
YOOKASSA_PAYOUT_AGENT_ID=
YOOKASSA_PAYOUT_SECRET_KEY=

# Optional base address override (defaults to https://api.yookassa.ru/v3/).
YOOKASSA_BASE_URL=
